{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    "target": "es6",
    "module": "commonjs",
    "declaration": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "emitDecoratorMetadata": true,
    "outDir": "build",
    "skipLibCheck": true,
    "rootDir": ".",
    // @types/jest здесь не нужен: тестовые файлы в сборку не входят (см. exclude).
    "types": ["@types/express", "@types/node"]
  },
  "include": ["src/lib/**/*"],
  // ВНИМАНИЕ: glob-синтаксис TypeScript поддерживает только `*`, `?` и `**/`.
  // Групп с альтернативой — `*.(test|spec).ts` — в нём НЕТ: такой шаблон не совпадает
  // ни с одним файлом, поэтому раньше тесты молча компилировались и попадали в npm-пакет.
  // Каждое расширение нужно перечислять отдельным шаблоном.
  "exclude": [
    "build",
    "node_modules",
    "examples",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/test/**/*"
  ]
}
