    {
      "name": "$select и $expand",
      "item": [
        {
          "name": "Выбор полей",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/books?$select=id,title",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books"
              ],
              "query": [
                {
                  "key": "$select",
                  "value": "id,title"
                }
              ]
            },
            "description": "Выбираются только указанные колонки."
          },
          "response": []
        },
        {
          "name": "Связи",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/books?$select=id,title&$expand=author,publisher",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books"
              ],
              "query": [
                {
                  "key": "$select",
                  "value": "id,title"
                },
                {
                  "key": "$expand",
                  "value": "author,publisher"
                }
              ]
            },
            "description": "Две связи «многие к одному» одним запросом: один LEFT JOIN на каждую."
          },
          "response": []
        },
        {
          "name": "Вложенный $select",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/books?$select=id,title&$expand=author($select=name)",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books"
              ],
              "query": [
                {
                  "key": "$select",
                  "value": "id,title"
                },
                {
                  "key": "$expand",
                  "value": "author($select=name)"
                }
              ]
            },
            "description": "Ограничение колонок внутри связи. Ключ TypeORM добавляет сам — он нужен, чтобы разложить плоский результат JOIN по родителям."
          },
          "response": []
        },
        {
          "name": "Связь «многие ко многим»",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/books?$expand=tags&$filter=tags/label eq 'classic'",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books"
              ],
              "query": [
                {
                  "key": "$expand",
                  "value": "tags"
                },
                {
                  "key": "$filter",
                  "value": "tags/label eq 'classic'"
                }
              ]
            },
            "description": "Метки лежат за таблицей связи. Книга с двумя метками не задваивается: TypeORM склеивает строки обратно по идентификатору."
          },
          "response": []
        },
        {
          "name": "Связь «один к одному»",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/books?$expand=details&$filter=details/isbn ne null",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books"
              ],
              "query": [
                {
                  "key": "$expand",
                  "value": "details"
                },
                {
                  "key": "$filter",
                  "value": "details/isbn ne null"
                }
              ]
            },
            "description": "В отличие от коллекции, здесь $expand даёт объект или null."
          },
          "response": []
        },
        {
          "name": "Ссылка на саму себя",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/categories?$expand=children&$filter=parent eq null",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "categories"
              ],
              "query": [
                {
                  "key": "$expand",
                  "value": "children"
                },
                {
                  "key": "$filter",
                  "value": "parent eq null"
                }
              ]
            },
            "description": "Раздел внутри раздела: JOIN таблицы с ней же, алиасы обязаны различаться."
          },
          "response": []
        },
        {
          "name": "Двухуровневый $expand",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/authors?$expand=books($expand=reviews)",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "authors"
              ],
              "query": [
                {
                  "key": "$expand",
                  "value": "books($expand=reviews)"
                }
              ]
            },
            "description": "Три уровня связи: автор → книги → рецензии."
          },
          "response": []
        },
        {
          "name": "Вложенный $orderby",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/authors?$expand=books($orderby=id desc)",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "authors"
              ],
              "query": [
                {
                  "key": "$expand",
                  "value": "books($orderby=id desc)"
                }
              ]
            },
            "description": "Сортировка внутри связи. Корневой $orderby применяется раньше — иначе сортировка связи управляла бы порядком авторов (дефект A-14)."
          },
          "response": []
        },
        {
          "name": "Вложенная пагинация",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/authors?$expand=books($orderby=id desc;$top=1)",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "authors"
              ],
              "query": [
                {
                  "key": "$expand",
                  "value": "books($orderby=id desc;$top=1)"
                }
              ]
            },
            "description": "Срез связанных строк на каждого родителя. Обычным LIMIT это не выражается: в запросе с LEFT JOIN он действует на весь плоский результат, а не на группу строк одного родителя. Поэтому страницу вырезает оконная функция ROW_NUMBER() в условии соединения, и из базы поднимается только она. Там, где так нельзя (MySQL, незнакомый драйвер, вложенный $orderby по соседней связи, опция nestedPaginationInSql: false), библиотека возвращается к срезу над деревом сущностей — результат тот же."
          },
          "response": []
        },
        {
          "name": "Поле связи в $select",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/books?$select=id,title,author/name",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books"
              ],
              "query": [
                {
                  "key": "$select",
                  "value": "id,title,author/name"
                }
              ]
            },
            "description": "Путь по связи прямо в $select: связь подключается сама, отдельный $expand не нужен, и в ответе у author остаётся только name. Добавлять при этом $expand=author не стоит — он затребует все колонки связи и перекроет сужение: получится author целиком."
          },
          "response": []
        }
      ]
    },
