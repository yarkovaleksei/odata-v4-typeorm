          "name": "Все записи",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/books",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books"
              ],
              "query": []
            },
            "description": "Ответ по умолчанию — массив: отсутствующий $count по OData v4 (раздел 11.2.5.5) означает false, и лишний COUNT(*) не выполняется."
          },
          "response": []
        },
        {
          "name": "Со счётчиком",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/books?$count=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books"
              ],
              "query": [
                {
                  "key": "$count",
                  "value": "true"
                }
              ]
            },
            "description": "С $count=true форма ответа меняется на { items, count } и выполняется второй запрос — COUNT(*) по тем же фильтрам."
          },
          "response": []
        },
